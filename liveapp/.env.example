# DGP Live Dashboard - configuration
# Copy this file to `.env` in the liveapp folder and fill in your values.

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# Supabase: Project settings -> Database -> Connection string -> URI
# Choose "Session pooler" (port 5432) for long-running jobs, or
# "Transaction pooler" (port 6543). Keep the password URL-encoded.
#
# Direct connection example:
#   DGP_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
# Pooler connection example (recommended for this app):
#   DGP_DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-AP-SOUTH-1.pooler.supabase.com:5432/postgres
#
# Leave EMPTY to fall back to the local SQLite file (storage/dgp.db).
DGP_DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate a strong secret, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
DGP_JWT_SECRET=change-me-in-production-please-set-DGP_JWT_SECRET
DGP_TOKEN_TTL_MINUTES=720

# ---------------------------------------------------------------------------
# First-run admin (used only when the users table is empty)
# ---------------------------------------------------------------------------
# A serverless deployment has no seed_users.json, so these create the initial
# admin. They are ignored once any user exists - changing the password here
# never affects a database that already has logins.
DGP_BOOTSTRAP_ADMIN_USERNAME=
DGP_BOOTSTRAP_ADMIN_PASSWORD=
DGP_BOOTSTRAP_ADMIN_DISPLAY_NAME=

# ---------------------------------------------------------------------------
# Deployment capabilities
# ---------------------------------------------------------------------------
# Import a dashboard bundle from the browser. Set to 0 on serverless platforms,
# where the write takes far longer than the function timeout; publish from the
# source machine with publish_site.py instead.
DGP_IMPORT_ENABLED=1
# Spawning the ETL scripts in-process. Needs a writable checkout and a
# long-lived interpreter, so set to 0 on serverless platforms.
DGP_LOCAL_PROCESSING_ENABLED=1

# ---------------------------------------------------------------------------
# Processing
# ---------------------------------------------------------------------------
# Per-script timeout in seconds (default 3600).
DGP_ETL_STEP_TIMEOUT=3600
# Set to 1 to skip the filesystem ETL scripts and only rebuild the dashboard
# payload from files already present.
DGP_SKIP_SOURCE_SCRIPTS=0

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Leave blank unless a separate frontend host calls this API.
DGP_CORS_ORIGINS=