{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": [
        "_dashboard_template.html",
        "liveapp/frontend/index.html",
        "liveapp/frontend/app.js"
      ]
    }
  },
  "excludeFiles": [
    "**/__pycache__/**",
    "**/.venv/**",
    "Input/**",
    "History/**",
    "Output/**",
    "liveapp/storage/**",
    "liveapp/.env"
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}