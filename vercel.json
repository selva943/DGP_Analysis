{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "api",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "includeFiles": [
    "_dashboard_template.html",
    "liveapp/frontend/**/*"
  ],
  "excludeFiles": [
    "**/__pycache__/**",
    "**/.venv/**",
    "Input/**",
    "History/**",
    "Output/**",
    "liveapp/storage/**",
    "liveapp/.env"
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ]
}