# ===========================================================================
# Secrets — never commit
# ===========================================================================
.env
.env.*
!.env.example
liveapp/.env
# Holds the shared plaintext employee password. The users already live in the
# database, so the app does not need this file on the server.
liveapp/seed_users.json

# ===========================================================================
# Data files — these belong on the build machine, not in git
# ~450 MB total. GitHub rejects files over 100 MB and large repos are slow to
# clone. The database (Supabase) is the source of truth for published data.
# ===========================================================================
Input/
History/
history/archive/
Output/
output/site/
output/site.zip
updating_files/
*.xlsx
*.csv
*.parquet

# Legacy SQLite fallback database (107 MB). Superseded by Supabase.
liveapp/storage/*.db
storage/

# ===========================================================================
# Python
# ===========================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ===========================================================================
# Vercel
# ===========================================================================
.vercel/

# ===========================================================================
# Keep — required by the deployed app
# ===========================================================================
# _dashboard_template.html must be committed: api/index.py serves it and it is
# the dashboard's entire UI.